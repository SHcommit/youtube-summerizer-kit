%%{init: {"theme":"base","themeVariables":{"fontFamily":"Arial, sans-serif","primaryTextColor":"#172554","lineColor":"#64748b","clusterBkg":"#ffffff","clusterBorder":"#cbd5e1"},"flowchart":{"curve":"basis","nodeSpacing":32,"rankSpacing":44}}}%%
flowchart TB
    SOURCE["Source identity + raw transcript"]
    VALIDATE["Validate + prepare transcript"]
    EXTRACT["Grounded extraction<br/>Frontier reasoning"]
    GROUND["Local evidence grounding<br/>Validate source spans + timestamps"]
    PACK["Knowledge Pack<br/>Versioned reusable knowledge"]
    RENDER["Deterministic output rendering<br/>Digest · Blog · Study · Obsidian"]

    SOURCE --> VALIDATE --> EXTRACT --> GROUND --> PACK --> RENDER

    CONTROL["Run control<br/>Policy · immutable checkpoints · pause/resume<br/>Unknown external outcome handling"]
    STATE["Durable state<br/>SQLite job state · content-addressed artifacts"]
    OBSERVE["Observability<br/>Structured logs · OpenTelemetry spans · optional Jaeger export"]

    CONTROL -.-> VALIDATE
    CONTROL -.-> EXTRACT
    CONTROL -.-> GROUND
    STATE -.-> SOURCE
    STATE -.-> PACK
    STATE -.-> RENDER
    OBSERVE -.-> VALIDATE
    OBSERVE -.-> EXTRACT
    OBSERVE -.-> GROUND

    classDef source fill:#dbeafe,stroke:#2563eb,stroke-width:2px,color:#172554;
    classDef process fill:#ede9fe,stroke:#7c3aed,stroke-width:2px,color:#2e1065;
    classDef knowledge fill:#fef3c7,stroke:#d97706,stroke-width:2.5px,color:#78350f;
    classDef output fill:#dcfce7,stroke:#16a34a,stroke-width:2px,color:#14532d;
    classDef support fill:#f8fafc,stroke:#64748b,stroke-width:1.5px,stroke-dasharray:5 3,color:#0f172a;
    class SOURCE source;
    class VALIDATE,EXTRACT,GROUND process;
    class PACK knowledge;
    class RENDER output;
    class CONTROL,STATE,OBSERVE support;
